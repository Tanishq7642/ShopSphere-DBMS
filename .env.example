# ============================================================================
# ShopSphere-DBMS · environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in your values:   cp .env.example .env
# .env is git-ignored - never commit real credentials.
# ============================================================================

# PostgreSQL connection for the web app (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db"

# Optional: psql binary path if not on PATH (used by scripts/setup_db.sh)
# PSQL="/c/Program Files/PostgreSQL/17/bin/psql"

# Optional: override CLI/verification defaults
# PGUSER=postgres
# PGPASSWORD=postgres
# DB_NAME=ecommerce_db
# PGHOST=localhost
# PGPORT=5432
